#!/bin/bash
# Nexum-Backend — bootstrap de instancia privada (I-020).
#
# Sin NAT ni IPv4 publica: el binario se obtiene de S3 por el gateway endpoint,
# se verifica su SHA-256 y se instala de forma atomica. No descarga nada de
# Internet, no contiene secretos y es idempotente.
#
# Variables sustituidas por Terraform:
#   ${artefacto_uri}  s3://bucket/clave
#   ${artefacto_sha}  sha256 hexadecimal de 64 caracteres
#   ${servicio}       nombre del servicio systemd
set -euo pipefail

ARTEFACTO="${artefacto_uri}"
SHA_ESPERADO="${artefacto_sha}"
SERVICIO="${servicio}"
USUARIO="nexum"
DIR_BIN="/opt/nexum/bin"
DIR_CFG="/etc/nexum"
DIR_ESTADO="/var/lib/nexum"
DIR_LOGS="/var/log/nexum"
TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

log() { printf '%s\n' "[bootstrap] $*"; }

if [[ "$(id -u)" -ne 0 ]]; then
  log "ERROR: el bootstrap debe ejecutarse como root (lo invoca cloud-init)"
  exit 1
fi

# Usuario no privilegiado del servicio (idempotente).
if ! id -u "$USUARIO" >/dev/null 2>&1; then
  useradd --system --home-dir /opt/nexum --shell /usr/sbin/nologin "$USUARIO"
fi

install -d -m 0750 -o "$USUARIO" -g "$USUARIO" "$DIR_BIN" "$DIR_ESTADO" "$DIR_LOGS"
install -d -m 0750 -o root -g "$USUARIO" "$DIR_CFG"

# Descarga desde S3 por el gateway endpoint, con la identidad de la instancia.
if ! aws s3 cp --only-show-errors "$ARTEFACTO" "$TMP/nexum-backend"; then
  log "ERROR: no se pudo descargar $ARTEFACTO (¿gateway endpoint S3 o IAM?)"
  exit 1
fi

# Verificacion de integridad antes de tocar el binario en uso.
CALCULADO="$(sha256sum "$TMP/nexum-backend" | awk '{print $1}')"
if [[ "$CALCULADO" != "$SHA_ESPERADO" ]]; then
  log "ERROR: SHA-256 no coincide (esperado $SHA_ESPERADO, obtenido $CALCULADO)"
  exit 1
fi
log "SHA-256 verificado: $CALCULADO"

# Instalacion atomica: se escribe en el mismo sistema de archivos y se renombra.
install -m 0755 -o "$USUARIO" -g "$USUARIO" "$TMP/nexum-backend" "$DIR_BIN/.nexum-backend.nuevo"
mv -f "$DIR_BIN/.nexum-backend.nuevo" "$DIR_BIN/nexum-backend"

if [[ -f /etc/systemd/system/"$SERVICIO".service ]]; then
  systemctl daemon-reload
  systemctl enable "$SERVICIO" >/dev/null 2>&1 || true
  systemctl restart "$SERVICIO"
else
  log "AVISO: unidad $SERVICIO no encontrada; el binario queda instalado sin activar"
fi

log "bootstrap completado"
