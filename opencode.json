{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "constitution.md",
    "memoria.md"
  ],
  "permissions": [
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "read",
      "resource": "constitution.md",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "AGENTS.md",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "memoria.md",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "README.md",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "opencode.json",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": ".gitignore",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "subagent",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "skill",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "webfetch",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "websearch",
      "resource": "*",
      "effect": "ask"
    }
  ],
  "policies": [
    {
      "action": "tool.use",
      "resource": "shell:*",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "external_directory:*",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "subagent:*",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "skill:*",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "read:*.env*",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "read:*.tfstate*",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "read:*.pem",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "read:*.key",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "read:*/.ssh/*",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "read:*/.aws/*",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "edit:sdd/*",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "edit:cmd/*",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "edit:internal/*",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "edit:infra/*",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "edit:tests/*",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "edit:.github/*",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "edit:*.go",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "edit:*.tf",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "edit:*.tfvars*",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "edit:*.env*",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "edit:*.pem",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "edit:*.key",
      "effect": "deny"
    }
  ]
}
