# Todos los documentos de SDD usan finales LF, incluso desde Windows con core.autocrlf=true.
# El SHA-256 mide los bytes desplegados realmente en GitHub Actions.
*.md text eol=lf
*.py text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.csv text eol=lf
*.txt text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
*.tf text eol=lf
*.hcl text eol=lf
*.service text eol=lf
*.ps1 text eol=lf
*.go text eol=lf
*.toml text eol=lf
*.tftpl text eol=lf
*.sh text eol=lf
*.example text eol=lf
